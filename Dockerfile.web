# --- Etapa 1: Builder ---
FROM node:22-bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN npm install -g pnpm

# Copiar configuración del workspace
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* turbo.json ./
# Copiar configuración de aplicaciones y paquetes NECESARIOS
COPY apps/web ./apps/web
COPY packages/config ./packages/config

# Instalar todas las dependencias
RUN pnpm install

# Construir el frontend
RUN pnpm --filter web build

# Crear directorio exclusivo para dependencias de producción
RUN pnpm --filter web --prod deploy /app/prod-deps

# --- Etapa 2: Runner ---
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

# Crear usuario seguro
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nodejs

# Copiar solo los artefactos necesarios para Next.js start
COPY --from=builder /app/prod-deps/package.json ./package.json
COPY --from=builder /app/prod-deps/node_modules ./node_modules
COPY --from=builder /app/apps/web/.next ./.next
COPY --from=builder /app/apps/web/public ./public

USER nodejs

ENV PORT=8080
ENV HOSTNAME="0.0.0.0"
# Iniciar la aplicación
CMD ["./node_modules/.bin/next", "start"]
