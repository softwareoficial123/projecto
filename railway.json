{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "api-gateway": {
      "source": "Dockerfile.api",
      "rootDirectory": ".",
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "healthcheckPath": "/health"
      }
    },
    "web": {
      "source": "Dockerfile.web",
      "rootDirectory": ".",
      "deploy": {
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}
