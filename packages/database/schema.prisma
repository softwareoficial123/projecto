generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id    String @id @default(uuid())
  name  String
  users User[]
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  role      Role   @relation(fields: [roleId], references: [id])
  roleId    String
  metadata  Json
  
  @@index([metadata], type: Gin)
}

model Role {
  id     String @id @default(uuid())
  name   String
  config Json
  users  User[]
}
