// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Modelo de Usuario (Estructural) ---
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  tenantId  String   // Para aislamiento de datos
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campo JSONB para datos variables con control de versión
  // Estructura: { "_v": number, "data": object }
  dynamicData Json @default("{\"_v\": 1, \"data\": {}}")

  @@index([tenantId])
  @@index([dynamicData], type: Gin)
  @@map("users")
}

// --- Modelo para Series Temporales (Telemetría/Logs) ---
model UserEvent {
  id        String   @id @default(uuid())
  time      DateTime @default(now())
  userId    String
  eventType String
  payload   Json     // Datos variables del evento

  @@index([userId])
  @@index([payload], type: Gin)
  @@map("user_events")
}
